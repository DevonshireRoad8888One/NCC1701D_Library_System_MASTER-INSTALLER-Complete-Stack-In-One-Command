import os
from pathlib import Path
from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker
from sqlalchemy import select, func, delete
from backend.app.models.base import Base
from backend.app.models.items import LibraryItem

DATA_ROOT = Path(os.getenv("LIBRARY_DATA_ROOT", "./data"))
DB_PATH = DATA_ROOT / "db" / "library.db"
DB_PATH.parent.mkdir(parents=True, exist_ok=True)
DATABASE_URL = f"sqlite+aiosqlite:///{DB_PATH}"
engine = create_async_engine(DATABASE_URL, echo=False, future=True)
AsyncSessionLocal = async_sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)

async def init_db():
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    print(f"Database initialized at {DB_PATH}")

async def get_item_by_id(item_id: int):
    async with AsyncSessionLocal() as session:
        result = await session.execute(select(LibraryItem).where(LibraryItem.id == item_id))
        return result.scalar_one_or_none()

async def create_item(filename, file_path, file_type, file_size, content_hash, timestamp, source_laptop, ingested_at, mime_type=None, title=None, description=None, content_preview=None, message_count=0):
    async with AsyncSessionLocal() as session:
        result = await session.execute(select(func.max(LibraryItem.chain_position)))
        max_position = result.scalar()
        chain_position = (max_position or 0) + 1
        item = LibraryItem(filename=filename, file_path=file_path, file_type=file_type, file_size=file_size, content_hash=content_hash, timestamp=timestamp, source_laptop=source_laptop, ingested_at=ingested_at, chain_position=chain_position, mime_type=mime_type, title=title, description=description, content_preview=content_preview, message_count=message_count, processed=False, cataloged=False, indexed=False)
        session.add(item)
        await session.commit()
        await session.refresh(item)
        return item

async def delete_item(item_id: int) -> bool:
    async with AsyncSessionLocal() as session:
        result = await session.execute(delete(LibraryItem).where(LibraryItem.id == item_id))
        await session.commit()
        return result.rowcount > 0

async def get_item_by_hash(content_hash: str):
    async with AsyncSessionLocal() as session:
        result = await session.execute(select(LibraryItem).where(LibraryItem.content_hash == content_hash))
        return result.scalar_one_or_none()

async def list_items(limit=50, offset=0, file_type=None, source_laptop=None):
    async with AsyncSessionLocal() as session:
        query = select(LibraryItem).order_by(LibraryItem.timestamp.desc(), LibraryItem.chain_position.desc())
        if file_type:
            query = query.where(LibraryItem.file_type == file_type)
        if source_laptop:
            query = query.where(LibraryItem.source_laptop == source_laptop)
        query = query.offset(offset).limit(limit)
        result = await session.execute(query)
        return result.scalars().all()

async def count_items(file_type=None, source_laptop=None):
    async with AsyncSessionLocal() as session:
        query = select(func.count(LibraryItem.id))
        if file_type:
            query = query.where(LibraryItem.file_type == file_type)
        if source_laptop:
            query = query.where(LibraryItem.source_laptop == source_laptop)
        result = await session.execute(query)
        return result.scalar()
EOF

