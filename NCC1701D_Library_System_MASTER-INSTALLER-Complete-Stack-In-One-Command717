@app.post("/api/import/upload")
async def upload_file(file: UploadFile = File(...)):
    allowed = {".json", ".mp4", ".webm", ".png", ".jpg", ".jpeg", ".pdf", ".mp3", ".wav", ".txt", ".md"}
    file_ext = Path(file.filename).suffix.lower()
    if file_ext not in allowed:
        raise HTTPException(status_code=400, detail=f"File type {file_ext} not allowed")
    imports_dir = DATA_ROOT / "imports"
    imports_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    safe_name = f"{timestamp}_{file.filename.replace(' ', '_')}"
    file_path = imports_dir / safe_name
    file_size = 0
    content_hash = hashlib.sha256()
    with open(file_path, "wb") as buffer:
        while chunk := await file.read(1024 * 1024):
            buffer.write(chunk)
            file_size += len(chunk)
            content_hash.update(chunk)
    content_hash_hex = content_hash.hexdigest()
    existing = await get_item_by_hash(content_hash_hex)
    if existing:
        return {"status": "duplicate", "filename": safe_name, "existing_id": existing.id}
    file_stat = file_path.stat()
    created_at = datetime.fromtimestamp(file_stat.st_ctime).isoformat()
    item = await create_item(filename=safe_name, file_path=str(file_path), file_type=file_ext, file_size=file_size, content_hash=content_hash_hex, timestamp=created_at, source_laptop=FLEET_NAME, ingested_at=datetime.now().isoformat())
    return {"status": "accepted", "filename": safe_name, "file_size": file_size, "item_id": item.id}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("backend.app.main:app", host=LIBRARY_HOST, port=LIBRARY_PORT, reload=False)
EOF

